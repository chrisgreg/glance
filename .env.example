# Protects the dashboard and admin API with a single login. Leave both blank to
# run without a login (only do that behind your own proxy/VPN). Password: 8+ characters.
GLANCE_ADMIN_USER=chris
GLANCE_ADMIN_PASSWORD=change-me-please

# Days of raw events to keep (minimum 2). Hourly and daily rollups are kept forever.
GLANCE_RETENTION_DAYS=7

GLANCE_LOG_LEVEL=info

# Bearer token for the read-only MCP endpoint (/mcp) that AI agents connect to.
# 16+ characters; leave blank to allow only the admin login there.
GLANCE_MCP_TOKEN=

# OAuth client from Google Cloud for the per-site "Connect Google Search Console"
# button. Register <your glance url>/api/v1/google/callback as the redirect URI.
GLANCE_GOOGLE_CLIENT_ID=
GLANCE_GOOGLE_CLIENT_SECRET=
